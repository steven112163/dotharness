#!/usr/bin/env bash
set -euo pipefail

# Build a CK tree inside the CK docker image, auto-detecting how to reach a build node.
# configure (re)generates build/ via cmake-ck-dev.sh (--scratch wipes first); build
# only runs ninja against an existing tree, never configures.
#
# Runs inside a --rm container off the CK image so the toolchain (gcc/amdclang++/ccache)
# is self-consistent and independent of the host; CK cross-compiles, so no GPU needed.
#
# Backend auto-detected (override MODE=direct|docker|srun): srun = one allocation on a
# CPU node via docker run --rm; docker = --rm container on a shared server; direct =
# run inline (dev container or bare ROCm box). A login node without srun looks like
# direct too -- force MODE=srun there.
#
# Repo path assumed identical on the build node (shared filesystem / bind mount).

# shellcheck source=bin/ckCommon disable=SC1091
source "$(dirname "$(readlink -f "$0")")/ckCommon"

REPO=${REPO:-$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")}
ARCH=${ARCH:-}
BUILD_DIR=${BUILD_DIR:-build}
MODE=${MODE:-}

usage() {
    cat >&2 <<EOF
Usage: $(basename "$0") {configure|build} [args...]

  configure   (re)generate $BUILD_DIR/ by running cmake-ck-dev.sh
  build       run ninja against an already-configured $BUILD_DIR/ (never configures)

Run '$(basename "$0") configure -h' or '$(basename "$0") build -h' for subcommand details.
EOF
    exit 1
}

usage_configure() {
    cat >&2 <<EOF
Usage: $(basename "$0") configure [--scratch] [--minimal] [gfx...] [-- <extra cmake args>]

  --scratch     wipe $BUILD_DIR/ and configure from zero (default: reuse existing build/ tree)
  --minimal     pass --minimal to cmake-ck-dev.sh (fewer instances, faster build)
  gfx...        GPU arch (e.g. gfx942); same as ARCH=, and discards (not merges
                with) an inherited ARCH= env var. Required in srun mode (CPU
                build node, nothing to probe). direct/docker: auto-detect.
                Pass multiple (gfx942 gfx950 gfx1250) or ARCH='gfx942;gfx950;gfx1250'
                (quoted: unquoted ";" splits into separate shell commands) for a
                single multi-arch fat binary.
  -- <args>     extra args forwarded to cmake-ck-dev.sh (each must be space-free;
                they are re-split on the build node)

Backend auto-detection (override with MODE): direct | docker | srun
Env overrides: IMAGE=$IMAGE  REPO=$REPO
               ARCH=<gfx...>[;<gfx...>...]  BUILD_DIR=$BUILD_DIR  MODE=<backend>
               CONSTRAINT=$CONSTRAINT (Slurm site; clear to allow any)
               CPUS=$CPUS (srun --cpus-per-task)  SRUN_EXTRA=<srun args>  IMAGE_DIR=$IMAGE_DIR
               DOCKER_SETUP_CMD=<cmd> or DOCKER_SETUP_CMD_FILE=$DOCKER_SETUP_CMD_FILE
               (one-time root setup baked into a derived image via docker
               commit, e.g. installing rocm[devel]; see template/ckdockersetup.example;
               file missing and var unset: no-op — NOTE: the default IMAGE needs
               this configured, or rocm[devel]/rocm-sdk will be missing)
               (no --time limit on srun; builds are one-shot, not holder-bound)
EOF
    exit 1
}

usage_build() {
    cat >&2 <<EOF
Usage: $(basename "$0") build [target...]

  target...     ninja targets to build (default: all). Requires a previously
                configured $BUILD_DIR/ tree; run '$(basename "$0") configure' first
                if $BUILD_DIR/build.ninja is missing.

Backend auto-detection (override with MODE): direct | docker | srun
Env overrides: IMAGE=$IMAGE  REPO=$REPO
               BUILD_DIR=$BUILD_DIR  MODE=<backend>
               CONSTRAINT=$CONSTRAINT (Slurm site; clear to allow any)
               CPUS=$CPUS (build uses all of them)  SRUN_EXTRA=<srun args>  IMAGE_DIR=$IMAGE_DIR
               DOCKER_SETUP_CMD=<cmd> or DOCKER_SETUP_CMD_FILE=$DOCKER_SETUP_CMD_FILE
               (one-time root setup baked into a derived image via docker
               commit, e.g. installing rocm[devel]; see template/ckdockersetup.example;
               file missing and var unset: no-op — NOTE: the default IMAGE needs
               this configured, or rocm[devel]/rocm-sdk will be missing)
               (no --time limit on srun; builds are one-shot, not holder-bound)
EOF
    exit 1
}

# TARGETS/EXTRA_CMAKE are re-split by word on the build node; a whitespace-bearing
# element would silently mangle. $@: the array(s) to check.
_reject_whitespace_args() {
    local _a
    for _a in "$@"; do
        case "$_a" in
        *[[:space:]]*)
            echo "ERROR: argument '$_a' contains whitespace; targets and extra cmake" >&2
            echo "  args are re-split on the build node and must be space-free." >&2
            exit 1
            ;;
        esac
    done
}

cmd_configure() {
    local SCRATCH=0 MINIMAL="" EXTRA_CMAKE=() CLI_ARCHS=()
    while [ $# -gt 0 ]; do
        case "$1" in
        --scratch) SCRATCH=1 ;;
        --minimal) MINIMAL="--minimal" ;;
        -h | --help) usage_configure ;;
        --)
            shift
            EXTRA_CMAKE=("$@")
            break
            ;;
        -*)
            echo "Unknown option: $1" >&2
            usage_configure
            ;;
        gfx*) CLI_ARCHS+=("$1") ;;
        *)
            echo "ERROR: 'configure' takes no target arguments (got '$1'); targets belong to 'build'." >&2
            usage_configure
            ;;
        esac
        shift
    done
    # Any CLI gfx* token fully discards (never merges with) an inherited ARCH env var.
    [ ${#CLI_ARCHS[@]} -gt 0 ] && ARCH=$(
        IFS=';'
        echo "${CLI_ARCHS[*]}"
    )

    _reject_whitespace_args ${EXTRA_CMAKE[@]+"${EXTRA_CMAKE[@]}"}

    # Resolve REPO to the CK project root (walk up for script/cmake-ck-dev.sh);
    # fail fast rather than configure in the wrong place.
    _require_ck_root

    # Pick the backend (see _detect_backend in ckCommon for the precedence rule).
    [ -n "$MODE" ] || MODE=$(_detect_backend build) || exit 1
    echo "Backend: $MODE"
    echo "Image: $IMAGE"

    # srun builds on CPU nodes need an explicit arch (no GPU to probe); direct/docker
    # can probe via rocminfo. A ;-joined ARCH is a multi-arch fat-binary request,
    # validated directly instead of via the single-arch resolver.
    if [[ "$ARCH" == *\;* ]]; then
        _validate_arch_list "$ARCH" || exit 1
    else
        _resolve_arch_or_require "$MODE" || exit 1
    fi

    local build_abs="$REPO/$BUILD_DIR"

    # Touch the shared filesystem here, not on the build node.
    if [ "$SCRATCH" -eq 1 ]; then
        echo "Scratch configure: removing $build_abs"
        rm -rf "$build_abs"
    fi
    mkdir -p "$build_abs"

    # Runs on the build node. Unescaped vars expand now (heredoc build time);
    # \$VARS stay literal, evaluated on the build node.
    local remote_prog
    remote_prog=$(
        cat <<EOF
set -o pipefail
if [ ! -e "$REPO/script/cmake-ck-dev.sh" ]; then
    echo "ERROR: repo not visible on \$(hostname -s) ($REPO missing)." >&2
    echo "  Landed on a node without your shared home; srun mode auto-retries." >&2
    exit $REPO_MISSING_RC
fi
cd "$build_abs"
CACHE_FLAGS=""
if command -v ccache >/dev/null 2>&1; then
    CACHE_FLAGS="-DCMAKE_HIP_COMPILER_LAUNCHER=ccache -DCMAKE_CXX_COMPILER_LAUNCHER=ccache -DCMAKE_C_COMPILER_LAUNCHER=ccache"
elif command -v sccache >/dev/null 2>&1; then
    CACHE_FLAGS="-DCMAKE_HIP_COMPILER_LAUNCHER=sccache -DCMAKE_CXX_COMPILER_LAUNCHER=sccache -DCMAKE_C_COMPILER_LAUNCHER=sccache"
fi
echo "Configuring ($ARCH) in $build_abs ..."
# \$ARCH is quoted: a multi-arch ";"-joined value must survive as one shell
# word here, not get parsed as separate statements by the remote bash -c.
../script/cmake-ck-dev.sh $MINIMAL .. "$ARCH" -G Ninja \$CACHE_FLAGS ${EXTRA_CMAKE[*]:-}
EOF
    )

    if _dispatch_build_like 0 "$build_abs" "$remote_prog"; then
        echo "Configure successful ($build_abs)"
    else
        echo "Configure failed ($build_abs)" >&2
        exit 1
    fi
}

cmd_build() {
    local TARGETS=()
    while [ $# -gt 0 ]; do
        case "$1" in
        -h | --help) usage_build ;;
        --scratch | --minimal | --)
            echo "ERROR: '$1' is a 'configure' option, not a 'build' option." >&2
            usage_build
            ;;
        gfx*)
            echo "ERROR: 'build' takes no arch arguments (got '$1'); pass arch to 'configure'." >&2
            usage_build
            ;;
        -*)
            echo "Unknown option: $1" >&2
            usage_build
            ;;
        *) TARGETS+=("$1") ;;
        esac
        shift
    done

    _reject_whitespace_args ${TARGETS[@]+"${TARGETS[@]}"}

    _require_ck_root

    [ -n "$MODE" ] || MODE=$(_detect_backend build) || exit 1
    echo "Backend: $MODE"
    echo "Image: $IMAGE"

    # NFS caveat: under srun, a `configure` on a different compute node may not have
    # build.ninja visible here yet (attribute caching), so this can spuriously report
    # "not configured" right after success -- retry `build` if that happens.
    local build_abs="$REPO/$BUILD_DIR"
    if [ ! -f "$build_abs/build.ninja" ]; then
        echo "ERROR: $build_abs is not configured (no build.ninja)." >&2
        echo "  Run '$(basename "$0") configure [gfx...]' first." >&2
        exit 1
    fi

    # Runs on the build node. Unescaped vars expand now (heredoc build time);
    # \$VARS stay literal, evaluated on the build node.
    local remote_prog
    remote_prog=$(
        cat <<EOF
set -o pipefail
if [ ! -e "$REPO/script/cmake-ck-dev.sh" ]; then
    echo "ERROR: repo not visible on \$(hostname -s) ($REPO missing)." >&2
    echo "  Landed on a node without your shared home; srun mode auto-retries." >&2
    exit $REPO_MISSING_RC
fi
cd "$build_abs"
# srun: use the reserved core budget, clamped to nproc in case the cap is absent.
# direct: shares the box, so half the cores capped at 128 (stay responsive, avoid
# OOM from CK's memory-hungry template compiles on large hosts).
if [ "$MODE" = srun ]; then
    JOBS=\${SLURM_CPUS_PER_TASK:-$CPUS}; _n=\$(nproc); [ \$JOBS -gt \$_n ] && JOBS=\$_n
else
    JOBS=\$(( \$(nproc) / 2 )); [ \$JOBS -gt 128 ] && JOBS=128
fi
[ \$JOBS -lt 1 ] && JOBS=1
echo "Building ${TARGETS[*]:-all} with -j\$JOBS ..."
ninja -j\$JOBS ${TARGETS[*]:-} 2>&1 | tee build.log
EOF
    )

    # NFS caveat: build/ artifacts take a few seconds to appear on the login node,
    # so trust the dispatch exit code rather than stat'ing outputs to "verify".
    if _dispatch_build_like 0 "$build_abs" "$remote_prog"; then
        echo "Build successful (log: $build_abs/build.log)"
    else
        echo "Build failed (log: $build_abs/build.log)" >&2
        exit 1
    fi
}

[ $# -gt 0 ] || usage
case "$1" in
configure)
    shift
    cmd_configure "$@"
    ;;
build)
    shift
    cmd_build "$@"
    ;;
-h | --help) usage ;;
*)
    echo "ERROR: unknown subcommand '$1' (want configure|build)." >&2
    usage
    ;;
esac
