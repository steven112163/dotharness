#!/usr/bin/env bash
set -euo pipefail

# ISA control-flow graphs for a CK binary: disassembles the amdgcn code object
# with llvm-objdump into one Graphviz .dot per kernel (no GPU run).
#
#   ckCfgProfile [--arch gfx...] <bin>

SELF_DIR=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)

# Disassembles (not compiles) an already-built binary, so skip ckCommon's build-sized
# CPUS default (128); set before sourcing ckExec so this wins over that default.
CPUS=${CPUS:-32}

# shellcheck source=bin/ckExec disable=SC1091
source "$SELF_DIR/ckExec"

REPO=${REPO:-$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")}
ARCH=${ARCH:-}
BIN=${BIN:-}
OUTDIR=${OUTDIR:-}
OBJDUMP=${OBJDUMP:-/opt/rocm/llvm/bin/llvm-objdump}
MODE=${MODE:-}

usage() {
    cat >&2 <<EOF
Usage: $(basename "$0") [--arch gfx...] <bin>

  --arch gfx...  GPU arch (e.g. gfx942); used to filter the code object
  <bin>          binary path (relative to REPO root, e.g. build/bin/foo)

Env overrides: REPO=$REPO  ARCH=<gfx...>  IMAGE=<image>
               OBJDUMP=<path>
               DOCKER_SETUP_CMD_FILE=<path> (one-time root image setup; see
               template/ckdockersetup.example)
EOF
    exit 1
}

while [ $# -gt 0 ]; do
    case "$1" in
    -h | --help) usage ;;
    --arch)
        [ $# -ge 2 ] || {
            echo "ERROR: --arch needs a value" >&2
            usage
        }
        ARCH="$2"
        shift 2
        ;;
    -*)
        echo "Unknown option: $1" >&2
        usage
        ;;
    *)
        BIN="$1"
        shift
        ;;
    esac
done

[ -n "$BIN" ] || {
    echo "ERROR: no binary given" >&2
    usage
}
[[ "$BIN" == */* ]] || BIN="build/bin/$BIN"

if [ ! -e "$REPO/$BIN" ]; then
    alt=$(_find_ck_root "$REPO" || _find_ck_root "$PWD") && REPO="$alt"
fi
if [ ! -e "$REPO/$BIN" ]; then
    echo "ERROR: binary not found: $REPO/$BIN" >&2
    exit 1
fi

MODE_DIR=$REPO/ck_profile_out/cfg
[ -n "$MODE" ] || MODE=$(_detect_backend build) || exit 1
# cfg only disassembles (no GPU run), so a failed arch probe isn't fatal; arch is
# just a label. Silence the probe's misleading error (e.g. "srun builds run on CPU nodes...").
_resolve_arch_or_require "$MODE" 2>/dev/null || true

# Each run gets its own immutable runs/<id>/ dir; "latest" points at the newest.
# Skipped when the caller overrides OUTDIR directly (debug/custom-location escape hatch).
RUN_ID=""
if [ -z "$OUTDIR" ]; then
    RUN_ID=$(_new_run_dir "$MODE_DIR")
    OUTDIR=$MODE_DIR/runs/$RUN_ID
fi
mkdir -p "$OUTDIR"
cp "$LIB_DIR/profile_readme.md" "$REPO/ck_profile_out/README.md" 2>/dev/null || true
bash "$LIB_DIR/git_exclude_outdir.sh" "$REPO" 2>/dev/null || true
echo "Extracting amdgcn code object from $BIN and disassembling ($ARCH) ..."
REMOTE_PROG="
set -e
tmp=\$(mktemp -d); cd \"\$tmp\"
uri=\$(roc-obj-ls '$REPO/$BIN' 2>/dev/null | grep gfx | awk '{print \$NF}' | head -1)
[ -z \"\$uri\" ] && { echo 'no amdgcn code object found in binary' >&2; exit 2; }
roc-obj-extract \"\$uri\" >/dev/null 2>&1
co=\$(ls *.co 2>/dev/null | head -1)
[ -z \"\$co\" ] && { echo 'roc-obj-extract produced no .co file' >&2; exit 3; }
'$OBJDUMP' -d \"\$co\" 2>/dev/null | python3 '$LIB_DIR/cfg_to_dot.py' --out '$OUTDIR' --arch '$ARCH'
rm -rf \"\$tmp\"
"
if _dispatch_build_like 0 "$REPO" "$REMOTE_PROG"; then
    rc=0
else
    rc=$?
fi
if [ $rc -eq 0 ]; then
    if [ -n "$RUN_ID" ]; then
        ln -sfn "runs/$RUN_ID" "$MODE_DIR/latest"
        echo "CFG DOT files in $OUTDIR (latest -> $MODE_DIR/latest)"
    else
        echo "CFG DOT files in $OUTDIR"
    fi
else
    echo "ckCfgProfile failed (exit $rc)"
fi
exit $rc
